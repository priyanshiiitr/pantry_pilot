# Copy this file to ".env" and fill in real values.
# .env is git-ignored, so your keys never end up in the repository.

# ---------- Web app ----------
# Used to sign login cookies. Put any long random string here.
SESSION_SECRET=replace-me-with-a-long-random-string

# Where the database lives. Leave commented out to use the default: data/pantrypilot.db
# DATABASE_URL=sqlite:///data/pantrypilot.db

# ---------- Demo city ----------
# Opening hours and driver availability are in this time zone.
CITY_NAME=Seattle, WA
CITY_TIMEZONE=America/Los_Angeles

# ---------- AI model (used from Step 6) ----------
# Which provider to use: anthropic | bedrock | openai
MODEL_PROVIDER=anthropic

# The model the agents use. Leave empty for now — we fill it in when you pick a provider.
MODEL_ID=
# Optional: a stronger model only for the Coordinator agent (empty = same as MODEL_ID)
COORDINATOR_MODEL_ID=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Amazon Bedrock (credentials come from `aws configure` or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
AWS_REGION=us-east-1

# ---------- Tracing (used from Step 13) ----------
# true = print OpenTelemetry spans to the terminal
OTEL_CONSOLE=false
