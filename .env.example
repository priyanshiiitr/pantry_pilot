# Copy this file to ".env" and fill in real values.
# .env is git-ignored, so your keys never end up in the repository.

# ---------- Web app ----------
# Used to sign login cookies. Put any long random string here.
SESSION_SECRET=replace-me-with-a-long-random-string

# Where the database lives. Leave commented out to use the default: data/pantrypilot.db
# DATABASE_URL=sqlite:///data/pantrypilot.db

# ---------- Demo city ----------
# Opening hours and driver availability are in this time zone.
CITY_NAME=Seattle, WA
CITY_TIMEZONE=America/Los_Angeles

# ---------- AI model (used from Step 6) ----------
# Which provider to use: groq | anthropic | bedrock | openai
MODEL_PROVIDER=groq

# The model the agents use.
#   groq:      openai/gpt-oss-120b   (free tier, fast — our default)
#   anthropic: claude-haiku-4-5-20251001
#   openai:    gpt-4o-mini (or similar)
#   bedrock:   global.anthropic.claude-sonnet-4-6 (or similar)
MODEL_ID=openai/gpt-oss-120b
# Optional: a stronger model only for the Coordinator agent (empty = same as MODEL_ID)
COORDINATOR_MODEL_ID=

# Groq (https://console.groq.com/keys) — free tier, used by default
GROQ_API_KEY=

# Optional. Groq's free tier caps tokens per MINUTE per key (8,000 at the time of
# writing), and one multi-agent run can spend that in two or three turns. List any
# extra keys here, comma-separated, and the agents fail over to the next one on a
# 429 instead of waiting out the backoff. Duplicates are ignored — the same key
# listed twice shares one budget.
GROQ_FALLBACK_API_KEYS=

# ---------- Deployment only (see docs/deployment.md) ----------
# Leave all three empty for local development: the Vite dev server proxies /api,
# so frontend and backend are one origin and none of this applies.

# Exact origin of the deployed frontend, e.g. https://pantrypilot.vercel.app.
# Comma-separated for more than one. No wildcard - the login cookie is a
# credentialed request, and browsers reject "*" for those.
FRONTEND_ORIGINS=

# true wherever the site is served over HTTPS. Switches the login cookie to
# SameSite=None; Secure, without which a cross-origin deployment silently drops
# it and every request looks logged out.
SECURE_COOKIES=false

# Shared secret for POST /api/tick, which lets an external scheduler drive the
# agents where a long-running worker can't run. Empty disables that endpoint.
TICK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Amazon Bedrock (credentials come from `aws configure` or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
AWS_REGION=us-east-1

# ---------- Tracing (used from Step 13) ----------
# true = print OpenTelemetry spans to the terminal
OTEL_CONSOLE=false
